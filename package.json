    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "linkedom": "^0.18.14",
    "lucide-react": "^1.65.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
