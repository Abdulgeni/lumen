{
  "name": "lumen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "migrate": "prisma migrate dev",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:check": "tsx --env-file=.env.local scripts/db-check.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "gemini:check": "tsx --env-file=.env.local scripts/gemini-check.ts",
    "extract:check": "tsx --env-file=.env.local scripts/extract-check.ts",
    "ratelimit:check": "tsx --env-file=.env.local scripts/ratelimit-check.ts",
    "stripe:setup": "tsx --env-file=.env.local scripts/stripe-setup.ts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "launch:check": "tsx scripts/launch-check.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/prisma-adapter": "^1.7.14",
